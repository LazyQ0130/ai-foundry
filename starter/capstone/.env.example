# C1 needs no services. For C2/C3 run node scripts/init-local-env.mjs.
# This inventory contains placeholders, not usable credentials. See docs/local-environment.md.
CAPSTONE_DB_PASSWORD=replace-with-local-random-password
DATABASE_URL=postgresql://capstone:replace-with-local-random-password@127.0.0.1:55439/capstone?schema=public
TEST_DATABASE_URL=postgresql://capstone:replace-with-local-random-password@127.0.0.1:55440/capstone_c8_eval?schema=public
GARAGE_RPC_SECRET=replace-with-64-hex-characters
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_BUCKET=capstone-private
S3_ACCESS_KEY_ID=replace-with-local-GK-key
S3_SECRET_ACCESS_KEY=replace-with-local-secret
C3_APP_ORIGIN=http://localhost:3000
AI_EMBEDDING_MODE=mock
AI_RESEARCH_MODE=mock
AI_REPORT_MODE=mock
AI_NOTE_MODE=mock
AI_EMBEDDING_DIMENSION=1024
