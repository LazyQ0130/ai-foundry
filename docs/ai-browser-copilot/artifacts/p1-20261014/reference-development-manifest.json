{
  "manifest_version": 3,
  "name": "AI 网页阅读与知识整理助手 · P1 · 开发",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "tabs",
    "scripting"
  ],
  "action": {
    "default_title": "打开 P1 阅读助手侧栏"
  },
  "commands": {
    "wxt:reload-extension": {
      "description": "Reload the extension during development",
      "suggested_key": {
        "default": "Alt+R"
      }
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' http://127.0.0.1:3080; object-src 'self';",
    "sandbox": "script-src 'self' 'unsafe-inline' 'unsafe-eval' http://127.0.0.1:3080; sandbox allow-scripts allow-forms allow-popups allow-modals; child-src 'self';"
  }
}