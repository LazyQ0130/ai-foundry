NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://aifoundry:change-me@localhost:5432/aifoundry?schema=public
SESSION_COOKIE_NAME=aifoundry_session
SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://localhost:5173
ADMIN_PHONE=
ADMIN_INITIAL_PASSWORD=
# Optional public customer-support assets, configured by the operator.
WECHAT_QR_URL=/wechat-contact.jpg
WECHAT_CONTACT=
ALL_ACCESS_PRICE=599
ALL_ACCESS_PROJECTS_PRICE=699
# Only set to 1 behind a single trusted reverse proxy; default is 0.
TRUST_PROXY_HOPS=0

# Server-only outbound email. Use a QQ SMTP authorization code, not the account password.
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=AIFoundry
