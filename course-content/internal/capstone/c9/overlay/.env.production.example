# Inventory only. Never use these placeholders as credentials. Copy into a secret manager.
NODE_ENV=production
APP_ORIGIN=https://replace-with-your-product-host
DATABASE_URL=postgresql://replace-user:replace-password@replace-db-host/research?sslmode=require
S3_ENDPOINT=https://replace-account.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=replace-private-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
AI_EMBEDDING_MODE=real
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=
AI_EMBEDDING_DIMENSION=1024
AI_RESEARCH_MODE=real
AI_REPORT_MODE=real
AI_NOTE_MODE=real
AI_CHAT_BASE_URL=
AI_CHAT_API_KEY=
# Brief / Report / Note use AI_CHAT_MODEL; Planner may use its own model.
AI_PLANNER_MODEL=qwen3.8-flash
# Disable Qwen thinking for the forced Planner function.
AI_CHAT_DISABLE_THINKING=1
AI_CHAT_MODEL=
MCP_EXTERNAL_URL=https://replace-with-your-product-host/api/mcp/external-research
MCP_EXTERNAL_AUTH_SECRET=
ACTION_APPROVAL_SECRET=
# No TEST_DATABASE_URL, NEXT_PUBLIC secrets, local HTTP or test flags in production.
