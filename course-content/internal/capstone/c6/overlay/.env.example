DATABASE_URL="postgresql://capstone:change-me@127.0.0.1:55438/capstone?schema=public"
TEST_DATABASE_URL="postgresql://capstone:change-me@127.0.0.1:55438/capstone?schema=public"
S3_ENDPOINT="http://127.0.0.1:3900"
S3_REGION="garage"
S3_BUCKET="private-research"
S3_ACCESS_KEY_ID="replace-with-private-key-id"
S3_SECRET_ACCESS_KEY="replace-with-private-secret"
C3_APP_ORIGIN="http://localhost:3132"
AI_EMBEDDING_MODE="mock"
AI_RESEARCH_MODE="mock"
AI_REPORT_MODE="mock"
# Opt-in real smoke only, server-only:
# AI_EMBEDDING_BASE_URL="https://your-provider.example/v1"
# AI_EMBEDDING_API_KEY="server-only-key"
# AI_EMBEDDING_MODEL="text-embedding-v4"
# AI_EMBEDDING_DIMENSION="1024"
# AI_CHAT_BASE_URL="https://your-provider.example/v1"
# AI_CHAT_API_KEY="server-only-key"
# AI_CHAT_MODEL="your-json-and-tool-capable-model"
# AI_CHAT_DISABLE_THINKING="1"

# External research is still off unless a Run explicitly enables it.
# Server-only config; do not expose through NEXT_PUBLIC_*.
MCP_EXTERNAL_URL="http://127.0.0.1:3132/api/mcp/external-research"
MCP_EXTERNAL_AUTH_SECRET="replace-with-random-at-least-32-byte-secret"
# Set only for explicit localhost testing of a production build:
# MCP_ALLOW_LOCAL_HTTP="1"
# Optional Crossref polite-pool contact, server config only:
# CROSSREF_MAILTO="your-contact@example.com"

# Planner can differ from Brief / Report / Note; omit to use AI_CHAT_MODEL.
AI_PLANNER_MODEL=qwen3.8-flash
