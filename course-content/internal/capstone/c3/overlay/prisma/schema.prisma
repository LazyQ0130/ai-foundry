generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int         @id @default(autoincrement())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  sessions     Session[]
  workspace    Workspace?
}

model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Workspace {
  id        Int            @id @default(autoincrement())
  ownerId   Int            @unique
  owner     User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  tasks     ResearchTask[]
  documents KnowledgeDocument[]
}

enum DocumentStatus {
  PENDING_UPLOAD
  PROCESSING
  READY
  FAILED
}

model KnowledgeDocument {
  id                  String         @id @default(uuid())
  workspaceId         Int
  workspace           Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title               String
  originalName        String
  mimeType            String
  byteSize            Int
  objectKey           String         @unique
  contentHash         String?
  status              DocumentStatus @default(PENDING_UPLOAD)
  errorCode           String?
  pageCount           Int?
  parserVersion       String         @default("pdfjs-6.4.299-text-v1")
  indexingVersion     String         @default("chunk-800-120-v1")
  processingStartedAt DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  chunks              KnowledgeChunk[]

  @@index([workspaceId, status, createdAt])
}

model KnowledgeChunk {
  id                 Int               @id @default(autoincrement())
  documentId         String
  document           KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position           Int
  page               Int?
  startOffset        Int
  endOffset          Int
  content            String
  citationKey        String
  embedding          Unsupported("vector(1024)")
  embeddingModel     String
  embeddingDimension Int
  indexingVersion    String
  createdAt          DateTime          @default(now())

  @@unique([documentId, indexingVersion, position])
  @@index([documentId, position])
}

model ResearchTask {
  id          Int       @id @default(autoincrement())
  workspaceId Int
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  title       String
  query       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId, createdAt])
}
