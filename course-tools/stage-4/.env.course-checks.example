# Optional local overrides. Copy only settings you need into .env.course-checks.
# Default: derive from the local DATABASE_URL in your project.
# Explicit TEST_DATABASE_URL must use 127.0.0.1:55433 and stage4_checks (4.6) or stage4_l7 (4.7).
# Never configure this variable in Production.
# TEST_DATABASE_URL=

# Uncomment and change only if the default Eval port 32747 is busy.
# AGENT_EVAL_PORT=32748
