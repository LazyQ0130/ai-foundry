{
  "name": "ai-browser-copilot-phase0",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare": "wxt prepare --config extension/wxt.config.ts",
    "dev": "wxt --config extension/wxt.config.ts",
    "api": "tsx api/src/server.ts",
    "api:fault": "tsx scripts/fault-api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "wxt build --config extension/wxt.config.ts",
    "zip": "wxt zip --config extension/wxt.config.ts",
    "browser:launch": "node scripts/browser-launch.mjs",
    "test:network": "tsx scripts/network-probe.ts",
    "test:worker-lifecycle": "tsx scripts/worker-lifecycle-probe.ts"
  },
  "dependencies": {
    "express": "5.2.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/chrome": "0.3.5",
    "@types/express": "5.0.6",
    "@types/node": "24.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@wxt-dev/module-react": "1.2.2",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "wxt": "0.21.4"
  }
}
